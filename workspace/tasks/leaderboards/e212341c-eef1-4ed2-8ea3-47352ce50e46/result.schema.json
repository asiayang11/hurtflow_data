{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "coverage": {
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "read",
              "unavailable"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "sourceId",
          "status",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "productUrl": {
            "type": "string",
            "maxLength": 500
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "tagline": {
            "type": "string",
            "maxLength": 400
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "votes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "launchDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sourceId",
          "productUrl",
          "name",
          "tagline",
          "rank",
          "votes",
          "launchDate"
        ],
        "additionalProperties": false
      }
    },
    "analysis": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "groups": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "problem": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "opportunity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "productUrls": {
                    "minItems": 1,
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 500
                    }
                  }
                },
                "required": [
                  "label",
                  "problem",
                  "opportunity",
                  "productUrls"
                ],
                "additionalProperties": false
              }
            },
            "insights": {
              "maxItems": 60,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "productUrl": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "capability": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "audience": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "nextStep": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "productUrl",
                  "capability",
                  "audience",
                  "nextStep"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "summary",
            "groups",
            "insights"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "coverage",
    "observations",
    "analysis"
  ],
  "additionalProperties": false
}